# PostgreSQL (docker compose up -d db)
DATABASE_URL=postgres://portrait:portrait@localhost:5432/portrait

# HTTP API
HOST=127.0.0.1
PORT=3000

# Where uploaded photos and generated portraits are stored
STORAGE_DIR=./var/storage

# Image provider: "mock" (local, no key needed) or "openai"
IMAGE_PROVIDER=mock
# OPENAI_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=gpt-image-1

# Queue tuning
MAX_ACTIVE_JOBS_PER_USER=2
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=120
WORKER_CONCURRENCY=2
