{
  "name": "@portrait/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/web.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../.env src/worker.ts",
    "migrate": "tsx --env-file-if-exists=../.env src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.4",
    "@fastify/static": "10.1.6",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
